module btb
#(
  parameter
  DATA_WIDTH = 32, 
  OP_CODE_WIDTH = 7,
  BUFFER_DEPTH = 20
)
(
  input [DATA_WIDTH-1:0] if_pc,

  input write_en, 
  input [DATA_WIDTH-1:0] ex_target,
  input [DATA_WIDTH-1:0] ex_pc 
  input ex_op_code, 
  
  output miss_hit 
  output [DATA_WIDTH-1:0] target, 
); 


  localparam BUFFER_WIDTH = DATA_WIDTH + DATA_WIDTH + 1 // {pc_tag|target|valid} 
  
  reg [DATA_WIDTH-1:0] buff [0:BUFFER_DEPTH-1]; 

  //read logic port 1 
  reg [$clog2(BUFFER_DEPTH)-1:0] buff_index_1; 
  reg [BUFFER_DEPTH-1:0] compares_1;
  assign miss_hit = |compares_1;   

  //read logic port 2
  reg [$clog2(BUFFER_DEPTH)-1:0] buff_index_2; 
  reg [BUFFER_DEPTH-1:0] compares_2;
  wire port_2_miss = |compares_2

  reg [$(BUFFER_DEPTH)-1:0] wrap_idx; 

  genvar i; 
  generate
    for (i = 0; i < BUFFER_DEPTH; i = i+1)
    begin: COMPARE 
      compares_1[i] = (buff[i][BUFFER_WIDTH-1 -: DATA_WIDTH] == if_pc) && buff[i][0];
      compares_2[i] = (buff[i][BUFFER_WIDTH-1 -: DATA_WIDTH] == ex_pc); 
    end
  endgenerate 
  
  //priority encoder port 1 
  integer j1; 
  always@(*)
  begin 
    for(j1 = 0; j1 < BUFFER_DEPTH; j1 = j1+1)
    begin 
      if(compares_1[j1])
      begin 
        buffer_index_1 = j1; 
      end 
    end 
  end

  //priority encoder port 2 
  integer j2; 
  always@(*)
  begin 
    for(j2 = 0; j2 < BUFFER_DEPTH; j2 = j2+1)
    begin 
      if(compares_2[j2])
      begin 
        buffer_index_2 = j2; 
      end 
    end 
  end

  integer k; 

  //write logic 
  always@(posedge clk)
  begin 
    if(reset)
    begin 
      wrap_idx <= 0; 
      for(k = 0; k < BUFFER_DEPTH; k = k+1)
      begin 
        buff[k] <= 0; 
      end 
    end 
    else 
    begin 
      if(write_en && ex_op_code == `B_TYPE)
      begin 
        //check if pc already exists in buffer, if not assign it to the wrap_idx location 
        if(port_2_miss)
        begin 
          buff[wrap_idx] <= {ex_pc,ex_target,1}; 
        end 
        else 
          buff[buffer_index_2] <= {ex_pc,ex_target,1}; 
      end
    end 
  end 
endmodule 


